ами" style="rounded=1;arcSize=22;whiteSpace=nowrap;html=1;fontSize=15;fontFamily=Helvetica;fontColor=#1C1C1C;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="693" y="1024" width="216" height="40" as="geometry"/></mxCell><mxCell id="c39" value="Управленческая отчётность" style="rounded=1;arcSize=22;whiteSpace=nowrap;html=1;fontSize=15;fontFamily=Helvetica;fontColor=#1C1C1C;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="919" y="1024" width="234" height="40" as="geometry"/></mxCell><mxCell id="c40" value="" style="rounded=1;arcSize=4;absoluteArcSize=1;arcSize=24;fillColor=#A9B19B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="80" y="1112" width="1400" height="140" as="geometry"/></mxCell><mxCell id="c41" value="7. Персонал" style="text;html=1;fillColor=none;strokeColor=none;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1C1C1C;" vertex="1" parent="1"><mxGeometry x="120" y="1126" width="1320" height="40" as="geometry"/></mxCell><mxCell id="c42" value="Кадровый учёт и зарплата" style="rounded=1;arcSize=22;whiteSpace=nowrap;html=1;fontSize=15;fontFamily=Helvetica;fontColor=#1C1C1C;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="120" y="1176" width="224" height="40" as="geometry"/></mxCell><mxCell id="c43" value="Расчёт премий продавцам" style="rounded=1;arcSize=22;whiteSpace=nowrap;html=1;fontSize=15;fontFamily=Helvetica;fontColor=#1C1C1C;align=center;verticalAlign=middle;fillColor=#FFF8D6;strokeColor=#F2D21B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="354" y="1176" width="225" height="40" as="geometry"/></mxCell><mxCell id="c44" value="Графики смен" style="rounded=1;arcSize=22;whiteSpace=nowrap;html=1;fontSize=15;fontFamily=Helvetica;fontColor=#1C1C1C;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry 