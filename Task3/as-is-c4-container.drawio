1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="kkt" target="ofd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="&lt;b&gt;Авторизация карты&lt;/b&gt;&lt;br&gt;&lt;i&gt;[канал терминала]&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.3;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="term" target="bank"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="&lt;b&gt;XML-пакет цен и справочников&lt;/b&gt;&lt;br&gt;&lt;i&gt;[ночью, 02:00]&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.3;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sap" target="ftp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="&lt;b&gt;Забирает пакет&lt;/b&gt;&lt;br&gt;&lt;i&gt;[FTP, раз в сутки]&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#A04000;strokeWidth=1.3;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ftp" target="ftpcl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="&lt;b&gt;&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.3;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ftpcl" target="ldb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="&lt;b&gt;Продажи и остатки за день&lt;/b&gt;&lt;br&gt;&lt;i&gt;[ночной файл — уточнить]&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#A04000;strokeWidth=1.3;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0.85;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="ldb" target="sap"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="644" y="445"/><mxPoint x="990" y="445"/><mxPoint x="990" y="387"/></Array></mxGeometry></mxCell><mxCell id="e13" value="&lt;b&gt;Лояльность: начисление и списание баллов&lt;/b&gt;&lt;br&gt;&lt;i&gt;[онлайн-запрос; без интернета — тайм-аут]&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#C0392B;strokeWidth=1.3;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0.9;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.15;entryDx=0;entryDy=0;" edge="1" parent="1" source="pos" target="sap"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="332" y="232"/><mxPoint x="1030" y="232"/><mxPoint x="1030" y="282"/></Array></mxGeometry></mxCell><mxCell id="e14" value="&lt;b&gt;Дамп номенклатуры старой кассы&lt;/b&gt;&lt;br&gt;&lt;i&gt;[CSV / XLS по email]&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.3;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="eng" target="mail"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="&lt;b&gt;Файл&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.3;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="mail" target="merch"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="&lt;b&gt;Загрузка сведённого файла&lt;/b&gt;&lt;br&gt;&lt;i&gt;[вручную]&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.3;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="merch" target="sap"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1800" y="372"/></Array></mxGeometry></mxCell><mxCell id="e17" value="&lt;b&gt;Акции&lt;/b&gt;&lt;br&gt;&lt;i&gt;[путь в магазин не описан — уточнить]&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#A04000;strokeWidth=1.3;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="promo" target="sap"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1260" y="160"/></Array></mxGeometry></mxCell><mxCell id="e18" value="&lt;b&gt;Остатки и заказы&lt;/b&gt;&lt;br&gt;&lt;i&gt;[интеграция не описана — уточнить]&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#A04000;strokeWidth=1.3;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="sf" target="sap"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1810" y="297"/></Array></mxGeometry></mxCell><mxCell id="b1" value="1" style="ellipse;html=1;fillColor=#C0392B;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1046" y="250" width="26" height="26" as="geometry"/></mxCell><mxCell id="b2" value="2" style="ellipse;html=1;fillColor=#C0392B;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1006" y="62" width="26" height="26" as="geometry"/></mxCell><mxCell id="b3" value="3" style="ellipse;html=1;fillColor=#C0392B;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="670" y="500" width="26" height="26" as="geometry"/></mxCell><mxCell id="b4" value="4" style="ellipse;html=1;fillColor=#C0392B;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="624" y="770" width="26" height="26" as="geometry"/></mxCell><mxCell id="b5" value="5" style="ellipse;html=1;fillColor=#C0392B;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="56" y="990" width="26" height="26" as="geometry"/></mxCell><mxCell id="b6" value="6" style="ellipse;html=1;fillColor=#C0392B;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1380" y="510" width="26" height="26" as="geometry"/></mxCell><mxCell id="b7" value="7" style="ellipse;html=1;fillColor=#C0392B;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1446" y="750" width="26" height="26" as="geometry"/></mxCell><mxCell id="b8" value="8" style="ellipse;html=1;fillColor=#C0392B;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1366" y="396" width="26" height="26" as="geometry"/></mxCell><mxCell id="fix" value="&lt;b&gt;Что исправлено относительно артефакта 1&lt;/b&gt;&lt;br&gt;&lt;b&gt;1.&lt;/b&gt; Связь касса → SAP «Real-time stock &amp;amp; loyalty, REST API» неверна. Цены и справочники приходят ночным XML-пакетом по FTP в 02:00 (артефакт 2, п. 7.1). Онлайн остаётся только запрос лояльности — без интернета он падает по тайм-ауту (INC-8402).&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; «HQ Cloud» → собственный ЦОД: SAP ERP развёрнута on-premises.&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; Local DB стоит на отдельном сервере в подсобке (INC-8433), а не на ПК кассы; СУБД — MS SQL Server или PostgreSQL с платными лицензиями, а не только MS SQL Express.&lt;br&gt;&lt;b&gt;4.&lt;/b&gt; Терминал не один (Ingenico): парк разнородный — Сбер (ARCUS-2), Альфа, Ingenico, Verifone; драйвер под каждую модель (INC-8415).&lt;br&gt;&lt;b&gt;5.&lt;/b&gt; Добавлены ОФД и процессинг эквайеров: без них не видно, куда уходят фискальные данные и платежи.&lt;br&gt;&lt;b&gt;6.&lt;/b&gt; Добавлен файловый обмен: FTP-сервер и агент приёма пакетов в магазине.&lt;br&gt;&lt;b&gt;7.&lt;/b&gt; Добавлен ручной процесс подключения магазина: выезд инженера, email, товаровед (артефакт 2, п. 4–6).&lt;br&gt;&lt;b&gt;8.&lt;/b&gt; Направление стрелки: данные идут из SAP в магазин, а не из кассы в SAP. Добавлены бэк-офис, Promo Engine и Smart Fulfillment; их связи помечены как требующие уточнения." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF8D6;strokeColor=#D4AC0D;align=left;verticalAlign=top;spacing=8;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1020" y="980" width="920" height="190" as="geometry"/></mxCell><mxCell id="leg" value="&lt;b&gt;Обозначения:&lt;/b&gt; синие — контейнеры (приложения и БД), тёмно-синие — люди, тёмно-серые — устройства, серые — внешние системы.&lt;br&gt;Сплошная стрелка — синхронное взаимодействие; &lt;font color=&quot;#A04000&quot;&gt;коричневая пунктирная&lt;/font&gt; — пакетный обмен (ночью); &lt;font color=&quot;#C0392B&quot;&gt;красная пунктирная&lt;/font&gt; — онлайн-вызов, который ломается без интернета.&lt;br&gt;Красные номера — исправления относительно артефакта 1 (см. справа)." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1110" width="940" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>