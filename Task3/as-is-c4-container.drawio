<mxfile host="app.diagrams.net"><diagram id="AS-IS" name="AS-IS"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1980" pageHeight="1220" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;AS-IS: кассовая зона и интеграция с HQ (C4 Container) — исправленная версия артефакта 1&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1700" height="40" as="geometry"/></mxCell><mxCell id="bStore" value="Магазин (Store Edge) — на примере купленного магазина [system]" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#666666;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="900" height="880" as="geometry"/></mxCell><mxCell id="cashier" value="&lt;b style=&quot;font-size:13px&quot;&gt;Кассир&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;Сотрудник магазина&lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=30;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#08427B;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="80" y="110" width="200" height="70" as="geometry"/></mxCell><mxCell id="storeman" value="&lt;b style=&quot;font-size:13px&quot;&gt;Сотрудник магазина&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;Приёмка, остатки, ценники&lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=30;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#08427B;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="360" y="110" width="200" height="70" as="geometry"/></mxCell><mxCell id="pos" value="&lt;b style=&quot;font-size:13px&quot;&gt;POS App (толстый клиент)&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[Windows, C#]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;Монолит: бизнес-логика кассы и встроенные драйверы устройств; у купленных сетей — свои кассовые системы&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#438DD5;align=center;verticalAlign=middle;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="260" width="280" height="150" as="geometry"/></mxCell><mxCell id="bo" value="&lt;b style=&quot;font-size:13px&quot;&gt;Бэк-офис магазина&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[Десктопное ПО]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;Товарный учёт, приёмка от локальных поставщиков, печать ценников&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#438DD5;align=center;verticalAlign=middle;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="260" width="250" height="150" as="geometry"/></mxCell><mxCell id="bSrv" value="Локальный сервер магазина (в подсобке)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#A04000;dashed=1;dashPattern=4 3;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#A04000;container=0;" vertex="1" parent="1"><mxGeometry x="400" y="470" width="500" height="190" as="geometry"/></mxCell><mxCell id="ldb" value="&lt;b style=&quot;font-size:13px&quot;&gt;Local DB&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[MS SQL Server / PostgreSQL]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;Чеки, справочник товаров и цены магазина&lt;/span&gt;" style="shape=cylinder3;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#438DD5;align=center;verticalAlign=middle;spacing=6;fontSize=11;size=14;boundedLbl=1;" vertex="1" parent="1"><mxGeometry x="440" y="510" width="240" height="130" as="geometry"/></mxCell><mxCell id="ftpcl" value="&lt;b style=&quot;font-size:13px&quot;&gt;Агент приёма пакетов&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[скрипт]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;Забирает XML с FTP и грузит в Local DB&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#438DD5;align=center;verticalAlign=middle;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="710" y="520" width="170" height="90" as="geometry"/></mxCell><mxCell id="kkt" value="&lt;b style=&quot;font-size:13px&quot;&gt;Фискальный регистратор (ККТ)&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[COM-порт]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;Печать фискального чека, фискальный накопитель&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#6B6B6B;fontColor=#FFFFFF;strokeColor=#6B6B6B;align=center;verticalAlign=middle;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="780" width="230" height="130" as="geometry"/></mxCell><mxCell id="term" value="&lt;b style=&quot;font-size:13px&quot;&gt;Банковские терминалы — разнородный парк&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[USB / COM]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;Сбер (ARCUS-2), Альфа, Ingenico, Verifone; под каждую модель — свой драйвер в кассе&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#6B6B6B;fontColor=#FFFFFF;strokeColor=#6B6B6B;align=center;verticalAlign=middle;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="780" width="300" height="130" as="geometry"/></mxCell><mxCell id="bHQ" value="Центральный офис (HQ) — собственный ЦОД, on-premises [system]" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#666666;container=0;" vertex="1" parent="1"><mxGeometry x="1020" y="70" width="920" height="880" as="geometry"/></mxCell><mxCell id="sap" value="&lt;b style=&quot;font-size:13px&quot;&gt;SAP ERP&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[on-premises]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;Товары, цены, кадры, финансы; программа лояльности&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#438DD5;align=center;verticalAlign=middle;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="260" width="300" height="150" as="geometry"/></mxCell><mxCell id="promo" value="&lt;b style=&quot;font-size:13px&quot;&gt;Promo Engine&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[собственная разработка]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;Единый движок акций&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#438DD5;align=center;verticalAlign=middle;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1460" y="110" width="220" height="100" as="geometry"/></mxCell><mxCell id="sf" value="&lt;b style=&quot;font-size:13px&quot;&gt;Smart Fulfillment&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[собственная разработка]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;Омниканальная логистика, Click &amp; Collect&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#438DD5;align=center;verticalAlign=middle;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1700" y="110" width="220" height="100" as="geometry"/></mxCell><mxCell id="ftp" value="&lt;b style=&quot;font-size:13px&quot;&gt;FTP-сервер&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[файловый обмен]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;Ночная рассылка XML-пакетов в магазины (02:00)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#438DD5;align=center;verticalAlign=middle;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="520" width="300" height="110" as="geometry"/></mxCell><mxCell id="mail" value="&lt;b style=&quot;font-size:13px&quot;&gt;Почтовый ящик&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[email]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;data-integration@vitastore.ru&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#438DD5;align=center;verticalAlign=middle;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1460" y="520" width="220" height="110" as="geometry"/></mxCell><mxCell id="merch" value="&lt;b style=&quot;font-size:13px&quot;&gt;Товаровед (HQ)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;VLOOKUP по штрихкодам, ручной маппинг: 500 позиций/ч&lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=30;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#08427B;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="1700" y="530" width="200" height="70" as="geometry"/></mxCell><mxCell id="eng" value="&lt;b style=&quot;font-size:13px&quot;&gt;Выездной ИТ-инженер&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;Подключение купленного магазина, ремонт сервера&lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=30;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#08427B;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="1460" y="760" width="200" height="70" as="geometry"/></mxCell><mxCell id="ofd" value="&lt;b style=&quot;font-size:13px&quot;&gt;ОФД&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[внешняя система]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;Оператор фискальных данных&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8C8C8C;fontColor=#FFFFFF;strokeColor=#8C8C8C;align=center;verticalAlign=middle;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="1000" width="230" height="90" as="geometry"/></mxCell><mxCell id="bank" value="&lt;b style=&quot;font-size:13px&quot;&gt;Процессинг банков-эквайеров&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[внешняя система]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;Авторизация карточных операций&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8C8C8C;fontColor=#FFFFFF;strokeColor=#8C8C8C;align=center;verticalAlign=middle;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="1000" width="300" height="90" as="geometry"/></mxCell><mxCell id="e1" value="&lt;b&gt;Работает с кассой&lt;/b&gt;&lt;br&gt;&lt;i&gt;[UI]&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.3;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cashier" target="pos"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="&lt;b&gt;Учёт, приёмка, ценники&lt;/b&gt;&lt;br&gt;&lt;i&gt;[UI]&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.3;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="storeman" target="bo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="&lt;b&gt;Читает цены, пишет чеки&lt;/b&gt;&lt;br&gt;&lt;i&gt;[SQL, синхронно]&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.3;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.6;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0