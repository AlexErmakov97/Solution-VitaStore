<mxfile host="app.diagrams.net"><diagram id="TO-BE HLD" name="TO-BE HLD"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;TO-BE: облачная кассовая архитектура VitaStore (High-Level Design)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="2200" height="40" as="geometry"/></mxCell><mxCell id="bStore" value="Магазин (Edge): только планшет, ККТ, терминал и связь" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1168BD;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#1168BD;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="820" height="1130" as="geometry"/></mxCell><mxCell id="cashier" value="&lt;b style=&quot;font-size:13px&quot;&gt;Кассир&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;Продажи, возвраты, выдача заказов Click &amp; Collect&lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=30;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#08427B;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="80" y="110" width="200" height="70" as="geometry"/></mxCell><mxCell id="bTab" value="Планшет кассира (Android, управляется через MDM)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1168BD;dashed=1;dashPattern=4 3;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#1168BD;container=0;" vertex="1" parent="1"><mxGeometry x="70" y="230" width="760" height="560" as="geometry"/></mxCell><mxCell id="webpos" value="&lt;b style=&quot;font-size:13px&quot;&gt;Cloud POS-клиент&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[Web POS (PWA) / лёгкое приложение]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;Тонкий клиент: интерфейс кассы, расчёт чека по локальному кешу&lt;br&gt;&lt;span style=&quot;background:#FFFFFF;color:#1E8449;font-weight:bold;font-size:10px&quot;&gt;&amp;nbsp;● работает офлайн&amp;nbsp;&lt;/span&gt;&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#1168BD;align=center;verticalAlign=middle;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="100" y="280" width="330" height="150" as="geometry"/></mxCell><mxCell id="cache" value="&lt;b style=&quot;font-size:13px&quot;&gt;Локальное хранилище&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[SQLite / IndexedDB, шифрование]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;Кеш: справочник и цены магазина, правила акций, балансы лояльности. Outbox: очередь операций с UUID&lt;br&gt;&lt;span style=&quot;background:#FFFFFF;color:#1E8449;font-weight:bold;font-size:10px&quot;&gt;&amp;nbsp;● работает офлайн&amp;nbsp;&lt;/span&gt;&lt;/span&gt;" style="shape=cylinder3;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#1168BD;align=center;verticalAlign=middle;spacing=6;fontSize=11;size=14;boundedLbl=1;" vertex="1" parent="1"><mxGeometry x="470" y="270" width="330" height="170" as="geometry"/></mxCell><mxCell id="hal" value="&lt;b style=&quot;font-size:13px&quot;&gt;HAL Agent — слой абстракции оборудования&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[локальный сервис на планшете, API на localhost (WebSocket)]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;Единый API для кассы: &lt;i&gt;printReceipt, pay, refund, openDrawer, xReport&lt;/i&gt;. Касса не знает модели устройств.&lt;br&gt;&lt;br&gt;&lt;b&gt;Плагины ККТ:&lt;/b&gt; АТОЛ, Штрих-М и др. (драйверы производителей)&lt;br&gt;&lt;b&gt;Плагины терминалов:&lt;/b&gt; Сбер (ARCUS-2 / UPOS), Альфа, Ingenico, Verifone&lt;br&gt;Новый протокол = новый плагин, доставляется через MDM без пересборки кассы&lt;br&gt;&lt;span style=&quot;background:#FFFFFF;color:#1E8449;font-weight:bold;font-size:10px&quot;&gt;&amp;nbsp;● работает офлайн&amp;nbsp;&lt;/span&gt;&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E67E22;fontColor=#FFFFFF;strokeColor=#E67E22;align=center;verticalAlign=middle;spacing=6;fontSize=11;strokeWidth=3;strokeColor=#A04000;" vertex="1" parent="1"><mxGeometry x="100" y="500" width="700" height="260" as="geometry"/></mxCell><mxCell id="kkt" value="&lt;b style=&quot;font-size:13px&quot;&gt;Фискальный регистратор&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[ККТ с фискальным накопителем]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;Фискализация чека; без связи копит документы в ФН&lt;br&gt;&lt;span style=&quot;background:#FFFFFF;color:#1E8449;font-weight:bold;font-size:10px&quot;&gt;&amp;nbsp;● работает офлайн&amp;nbsp;&lt;/span&gt;&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#6B6B6B;fontColor=#FFFFFF;strokeColor=#6B6B6B;align=center;verticalAlign=middle;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="840" width="230" height="120" as="geometry"/></mxCell><mxCell id="term" value="&lt;b style=&quot;font-size:13px&quot;&gt;Банковский терминал&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[Сбер / Альфа / Ingenico / Verifone]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;Карточные оплаты через свой канал к эквайеру&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#6B6B6B;fontColor=#FFFFFF;strokeColor=#6B6B6B;align=center;verticalAlign=middle;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="840" width="250" height="120" as="geometry"/></mxCell><mxCell id="router" value="&lt;b style=&quot;font-size:13px&quot;&gt;Роутер магазина&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[основной канал + LTE]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;Резервный канал снижает число офлайн-эпизодов&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#6B6B6B;fontColor=#FFFFFF;strokeColor=#6B6B6B;align=center;verticalAlign=middle;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="620" y="840" width="210" height="120" as="geometry"/></mxCell><mxCell id="ofd" value="&lt;b style=&quot;font-size:13px&quot;&gt;ОФД&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[внешняя система]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;Приём фискальных документов&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8C8C8C;fontColor=#FFFFFF;strokeColor=#8C8C8C;align=center;verticalAlign=middle;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="1060" width="230" height="100" as="geometry"/></mxCell><mxCell id="bank" value="&lt;b style=&quot;font-size:13px&quot;&gt;Процессинг эквайеров&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[внешняя система]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;Авторизация карт&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8C8C8C;fontColor=#FFFFFF;strokeColor=#8C8C8C;align=center;verticalAlign=middle;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="1060" width="250" height="100" as="geometry"/></mxCell><mxCell id="bCloud" value="Облако (Cloud Backend): российский облачный провайдер, данные в РФ (152-ФЗ)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#2C3E50;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#2C3E50;container=0;" vertex="1" parent="1"><mxGeometry x="940" y="70" width="1320" height="1130" as="geometry"/></mxCell><mxCell id="apigw" value="&lt;b style=&quot;font-size:13px&quot;&gt;API Gateway&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[управляемый сервис]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;Единая точка входа для планшетов: mTLS, авторизация устройств, лимиты&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#438DD5;align=center;verticalAlign=middle;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="980" y="110" width="420" height="100" as="geometry"/></mxCell><mxCell id="pgw" value="&lt;b style=&quot;font-size:13px&quot;&gt;Payment Gateway — облачная часть HAL&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[Build in Cloud]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;Единый платёжный API и маршрутизация по эквайерам; реестр устройств магазина и их плагинов; журнал операций и ежедневная сверка с эквайерами; конфигурация терминалов.&lt;br&gt;Подключение нового эквайера или терминала — новый адаптер здесь и плагин в HAL, без изменения кассы&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E67E22;fontColor=#FFFFFF;strokeColor=#E67E22;align=center;verticalAlign=middle;spacing=6;fontSize=11;strokeWidth=3;strokeColor=#A04000;" vertex="1" parent="1"><mxGeometry x="1440" y="110" width="780" height="190" as="geometry"/></mxCell><mxCell id="bPOS" value="Cloud POS (SaaS)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#2E8B8B;dashed=1;dashPattern=4 3;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#2E8B8B;container=0;" vertex="1" parent="1"><mxGeometry x="970" y="260" width="440" height="560" as="geometry"/></mxCell><mxCell id="sync" value="&lt;b style=&quot;font-size:13px&quot;&gt;Sync API&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[сервис синхронизации]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;Приём outbox (идемпотентно по UUID), выдача дельт справочников по версии&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#2E8B8B;fontColor=#FFFFFF;strokeColor=#2E8B8B;align=center;verticalAlign=middle;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="300" width="400" height="120" as="geometry"/></mxCell><mxCell id="cat" value="&lt;b style=&quot;font-size:13px&quot;&gt;Каталог и цены магазина&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;Ассортимент, цены, акции для конкретного магазина&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#2E8B8B;fontColor=#FFFFFF;strokeColor=#2E8B8B;align=center;verticalAlign=middle;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="440" width="190" height="140" as="geometry"/></mxCell><mxCell id="sales" value="&lt;b style=&quot;font-size:13px&quot;&gt;Продажи и чеки&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;Чеки, возвраты, смены, инкассация&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#2E8B8B;fontColor=#FFFFFF;strokeColor=#2E8B8B;align=center;verticalAlign=middle;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1200" y="440" width="190" height="140" as="geometry"/></mxCell><mxCell id="inv" value="&lt;b style=&quot;font-size:13px&quot;&gt;Товарный учёт магазина&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;Остатки в реальном времени, приёмка, инвентаризация&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#2E8B8B;fontColor=#FFFFFF;strokeColor=#2E8B8B;align=center;verticalAlign=middle;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="600" width="400" height="90" as="geometry"/></mxCell><mxCell id="mdm" value="&lt;b style=&quot;font-size:13px&quot;&gt;MDM устройств&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[SaaS]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;Zero-touch настройка планшетов, обновления приложения и плагинов HAL&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#2E8B8B;fontColor=#FFFFFF;strokeColor=#2E8B8B;align=center;verticalAlign=middle;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="710" width="400" height="90" as="geometry"/></mxCell><mxCell id="loy" value="&lt;b style=&quot;font-size:13px&quot;&gt;Программа лояльности&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[SaaS]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;Баллы, уровни, лимиты офлайн-списания&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#2E8B8B;fontColor=#FFFFFF;strokeColor=#2E8B8B;align=center;verticalAlign=middle;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1440" y="330" width="370" height="110" as="geometry"/></mxCell><mxCell id="promo" value="&lt;b style=&quot;font-size:13px&quot;&gt;Promo Engine&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[Build in Cloud, управляемые БД]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;Правила акций → кеш на кассе&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#438DD5;align=center;verticalAlign=middle;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1840" y="330" width="380" height="110" as="geometry"/></mxCell><mxCell id="bus" value="&lt;b style=&quot;font-size:13px&quot;&gt;Интеграционная шина&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[управляемый Kafka / iPaaS]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;События вместо ночного FTP: продажи, остатки, цены, ассортимент, акции&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#438DD5;align=center;verticalAlign=middle;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="860" width="1230" height="80" as="geometry"/></mxCell><mxCell id="sf" value="&lt;b style=&quot;font-size:13px&quot;&gt;Smart Fulfillment&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[Build in Cloud]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;Click &amp; Collect по остаткам в реальном времени&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#438DD5;align=center;verticalAlign=middle;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="990" width="290" height="110" as="geometry"/></mxCell><mxCell id="onb" value="&lt;b style=&quot;font-size:13px&quot;&gt;Платформа онбординга + SKU Matching&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[Build in Cloud]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;Подключение магазина за 5 дней (задание 2)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#438DD5;align=center;verticalAlign=middle;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1310" y="990" width="290" height="110" as="geometry"/></mxCell><mxCell id="sap" value="&lt;b style=&quot;font-size:13px&quot;&gt;SAP ERP&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[IaaS (rehost)]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;Эталонная номенклатура, цены, финансы&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#34495E;fontColor=#FFFFFF;strokeColor=#34495E;align=center;verticalAlign=middle;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1630" y="990" width="290" height="110" as="geometry"/></mxCell><mxCell id="mon" value="&lt;b style=&quot;font-size:13px&quot;&gt;Мониторинг&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:10px&quot;&gt;[метрики, логи]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;Состояние касс, очереди outbox, офлайн-магазины&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#438DD5;align=center;verticalAlign=middle;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1950" y="990" width="270" height="110" as="geometry"/></mxCell><mxCell id="loyq" value="&lt;b style=&quot;font-size:13px&quot;&gt;&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontColor=#333333;strokeColor=#BDC3C7;align=center;verticalAlign=middle;spacing=6;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="1440" y="470" width="690" height="330" as="geometry"/></mxCell><mxCell id="syncnote" value="&lt;b&gt;Синхронизация после восстановления связи&lt;/b&gt;&lt;br&gt;1. Касса отправляет outbox в порядке создания: чеки, возвраты, операции лояльности, кассовые операции. У каждой записи UUID и номер на устройстве.&lt;br&gt;2. Sync API применяет каждую запись один раз: повтор с тем же UUID — подтверждение без повторной обработки.&lt;br&gt;3. Продажи — неизменяемые факты, конфликтов нет; остатки и баллы пересчитываются в облаке.&lt;br&gt;4. Касса забирает дельты справочников, цен и акций с последней известной версии.&lt;br&gt;5. ККТ сама дозагружает фискальные документы из ФН в ОФД.&lt;br&gt;&lt;b&gt;Правила офлайна:&lt;/b&gt; наличные и фискальный чек — без ограничений; карты — если у терминала есть свой канал; списание баллов — в пределах лимита и кешированного баланса; без связи дольше 24 ч списание баллов отключается." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1455" y="478" width="665" height="320" as="geometry"/></mxCell><mxCell id="e1" value="&lt;b&gt;Работает с кассой&lt;/b&gt;&lt;br&gt;&lt;i&gt;[UI]&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.3;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cashier" target="webpos"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="&lt;b&gt;&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.3;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="webpos" target="cache"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="&lt;b&gt;Печать чека, оплата&lt;/b&gt;&lt;br&gt;&lt;i&gt;[localhost WebSocket, единый API]&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#A04000;strokeWidth=2;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.33;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="webpos" target="hal"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="&lt;b&gt;Фискализация&lt;/b&gt;&lt;br&gt;&lt;i&gt;[USB / COM / Bluetooth, плагин]&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#A04000;strokeWidth=2;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="hal" target="kkt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="&lt;b&gt;Оплата картой&lt;/b&gt;&lt;br&gt;&lt;i&gt;[ARCUS-2 / UPOS / протокол вендора, плагин]&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#A04000;strokeWidth=2;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.45;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="hal" target="term"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="&lt;b&gt;Фискальные документы&lt;/b&gt;&lt;br&gt;&lt;i&gt;[после восстановления — из ФН]&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.3;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="kkt" target="ofd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="&lt;b&gt;Авторизация&lt;/b&gt;&lt;br&gt;&lt;i&gt;[канал терминала]&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.3;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="term" target="bank"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="&lt;b&gt;Синхронизация&lt;/b&gt;&lt;br&gt;&lt;i&gt;[outbox ↑, дельты ↓]&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#1168BD;strokeWidth=2;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cache" target="apigw"><mxGeometry x="-0.1" relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="321"/><mxPoint x="900" y="160"/></Array></mxGeometry></mxCell><mxCell id="e9" value="&lt;b&gt;&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.3;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="apigw" target="sync"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="&lt;b&gt;Журнал операций, конфигурация, плагины&lt;/b&gt;&lt;br&gt;&lt;i&gt;[HTTPS, при наличии связи]&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#A04000;strokeWidth=2;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=1;exitY=0.15;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="hal" target="pgw"><mxGeometry x="0.62" relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="539"/><mxPoint x="880" y="240"/><mxPoint x="1420" y="240"/><mxPoint x="1420" y="243"/></Array></mxGeometry></mxCell><mxCell id="e11" value="&lt;b&gt;&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2E8B8B;strokeWidth=1.3;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.92;entryDx=0;entryDy=0;" edge="1" parent="1" source="mdm" target="bTab"><mxGeometry x="-0.95" relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="755"/><mxPoint x="900" y="745"/></Array></mxGeometry></mxCell><mxCell id="e12" value="&lt;b&gt;Баллы&lt;/b&gt;&lt;br&gt;&lt;i&gt;[API]&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.3;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sales" target="loy"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1422" y="482"/><mxPoint x="1422" y="385"/></Array></mxGeometry></mxCell><mxCell id="e13" value="&lt;b&gt;Правила акций → кеш на кассах&lt;/b&gt;&lt;br&gt;&lt;i&gt;[события]&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#438DD5;strokeWidth=1.3;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.95;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="promo" target="bus"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="&lt;b&gt;Продажи, остатки ↑ / цены, ассортимент ↓&lt;/b&gt;&lt;br&gt;&lt;i&gt;[события]&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.3;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.18;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="bPOS" target="bus"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="&lt;b&gt;&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.3;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.12;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="sf" target="bus"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="&lt;b&gt;&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.3;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.38;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="onb" target="bus"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="&lt;b&gt;&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.3;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.64;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="sap" target="bus"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e18" value="&lt;b&gt;&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.3;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.89;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="mon" target="bus"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="leg" value="&lt;b&gt;Обозначения:&lt;/b&gt; &lt;font color=&quot;#E67E22&quot;&gt;&lt;b&gt;■ оранжевые&lt;/b&gt;&lt;/font&gt; — слой абстракции оборудования (HAL Agent на планшете + Payment Gateway в облаке); &lt;font color=&quot;#1168BD&quot;&gt;&lt;b&gt;■ синие (Edge)&lt;/b&gt;&lt;/font&gt; — приложения на планшете; &lt;font color=&quot;#2E8B8B&quot;&gt;&lt;b&gt;■ бирюзовые&lt;/b&gt;&lt;/font&gt; — SaaS; &lt;font color=&quot;#438DD5&quot;&gt;&lt;b&gt;■ голубые&lt;/b&gt;&lt;/font&gt; — собственные сервисы в облаке; &lt;font color=&quot;#34495E&quot;&gt;&lt;b&gt;■ тёмные&lt;/b&gt;&lt;/font&gt; — IaaS; серые — устройства и внешние системы. Пунктир — взаимодействие только при наличии связи. «● работает офлайн» — компонент продолжает работать без интернета." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1215" width="2220" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>